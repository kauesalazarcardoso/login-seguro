# Copie este arquivo para .env e troque o valor abaixo.
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# Coloque 1 quando o sistema estiver rodando com HTTPS
COOKIE_SEGURO=0

CAMINHO_BANCO=dados/usuarios.db

# Porta do seu computador onde o sistema vai abrir (http://localhost:PORTA)
PORTA=5000
